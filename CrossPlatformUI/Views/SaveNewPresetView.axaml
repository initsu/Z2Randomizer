<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:z="clr-namespace:CrossPlatformUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CrossPlatformUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:SaveNewPresetViewModel"
             x:Class="CrossPlatformUI.Views.SaveNewPresetView">
    <Grid RowDefinitions="*, Auto">
        <StackPanel VerticalAlignment="Center">
            <z:Z2TextBox Name="PresetNameTextBox"
                     PlaceholderText="Preset Name"
                     Label="Enter a name for the preset"
                     Text="{Binding PresetName}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" IsEnabled="{Binding PresetName,
                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Command="{Binding SavePreset}" />
            <Button Content="Cancel" IsCancel="True" Classes="accent" Command="{Binding CancelPreset}" />
        </StackPanel>
    </Grid>
</UserControl>
