<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CrossPlatformUI.Views.NesColorDropdown"
             Width="340" Height="40" Foreground="{DynamicResource Z2ForegroundBrush}">
    <Grid ColumnDefinitions="108,222" Margin="16 0 0 0">
        <TextBlock Grid.Column="0" Margin="32, 0, 8, 0" Width="97" x:Name="ControlLabel" VerticalAlignment="Center" />

        <Button Grid.Column="1" x:Name="SelectedButton" BorderBrush="{DynamicResource Z2ColorPickerBorderBrush}" BorderThickness="1" Width="184" Height="32" Padding="16,0" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch">
            <TextBlock x:Name="SelectedLabel" VerticalAlignment="Center" Text="Default" TextTrimming="CharacterEllipsis" />
        </Button>

        <Popup x:Name="Popup"
               PlacementTarget="{Binding #SelectedButton}"
               Placement="Bottom"
               IsLightDismissEnabled="true">
            <Border Background="{DynamicResource Z2PaperBrush}" BorderBrush="{DynamicResource Z2ColorPickerBorderBrush}" BorderThickness="1" Padding="8">
                <StackPanel>
                    <Grid x:Name="PaletteGrid"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 8, 0, 0" Spacing="6">
                        <Button x:Name="DefaultButton" Content="Default" Width="100" Height="32"/>
                        <Button x:Name="RandomButton" Content="Random" Width="100" Height="32"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
