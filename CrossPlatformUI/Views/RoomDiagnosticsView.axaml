<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             x:Class="CrossPlatformUI.Views.RoomDiagnosticsView"
             x:DataType="vm:RoomDiagnosticsViewModel"
             MaxWidth="760">
    <UserControl.Styles>
        <Style Selector="SelectableTextBlock.suppressionHint">
            <Setter Property="Foreground" Value="{DynamicResource Z2SecondaryForegroundBrush}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <DataTemplate x:Key="SuggestionTemplate" x:DataType="vm:RoomDiagnosticsViewModel+Suggestion">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Padding="8 4" CornerRadius="4" Background="{DynamicResource Z2HoverBrush}">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                         FontFamily="monospace" VerticalAlignment="Center" />
                </Border>
                <Button Grid.Column="1" Content="{Binding CopyButtonText}" Command="{Binding Copy}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto, *, Auto" Margin="16" RowSpacing="12">
        <TextBlock Text="Custom Room Pool" Classes="SectionHeader" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rooms}" Margin="0 0 12 0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoomDiagnosticsViewModel+RoomEntries">
                        <StackPanel Margin="0 0 0 16" Spacing="4">
                            <SelectableTextBlock IsVisible="{Binding HasHeading}" Text="{Binding Heading}"
                                                 FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <SelectableTextBlock IsVisible="{Binding HasFilePath}" Text="{Binding FilePath}"
                                                 Foreground="{DynamicResource Z2SecondaryForegroundBrush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Rows}" Margin="0 4 0 0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoomDiagnosticsViewModel+Entry">
                                        <StackPanel Spacing="3">
                                            <SelectableTextBlock IsVisible="{Binding HasHeading}" Text="{Binding Heading}"
                                                                 FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                 Classes.suppressionHint="{Binding !HasHeading}" />
                                            <ContentControl IsVisible="{Binding HasSuggestion}" Content="{Binding Suggestion}"
                                                            ContentTemplate="{StaticResource SuggestionTemplate}"
                                                            HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Content="{Binding CopyButtonText}" Command="{Binding CopyReport}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Close" IsCancel="True" IsVisible="{Binding !AllowContinue}" Command="{Binding Close}" />
                <Button Content="Continue" Classes="accent" IsVisible="{Binding AllowContinue}" Command="{Binding Continue}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
