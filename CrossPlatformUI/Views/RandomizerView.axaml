<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:z="clr-namespace:CrossPlatformUI.Controls"
             xmlns:tabs="clr-namespace:CrossPlatformUI.Views.Tabs"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:ui="clr-namespace:CrossPlatformUI"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             xmlns:views="clr-namespace:CrossPlatformUI.Views"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             Design.Width="{x:Static ui:MainWindowSize.DefaultWidth}"
             Design.Height="{x:Static ui:MainWindowSize.DefaultHeight}"
             Name="RandomizerViewControl"
             x:DataType="vm:RandomizerViewModel"
             x:Class="CrossPlatformUI.Views.RandomizerView">
    <UserControl.Styles>
        <Style Selector="Button#RerollSeedButton">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="PathIcon#RerollSeedIcon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout z|Z2TextBox">
            <Setter Property="FontSize" Value="{DynamicResource Z2CompactInputFontSize}" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout z|Z2TextBox /template/ Grid#TextFieldRoot">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout z|Z2TextBox /template/ Border#LabelBorder TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Z2CompactLabelFontSize}" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout Button#RerollSeedButton">
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout PathIcon#RerollSeedIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout TabItem">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout TabItem:selected /template/ Path#TabOutline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|RandomizerView.CompactLayout TabItem:selected /template/ Grid#TabRoot">
            <Setter Property="Clip" Value="{Binding Bounds, RelativeSource={RelativeSource Self}, Converter={StaticResource TabIdleOutline}}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="ToolbarIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" Margin="15, 8">
        <Grid Grid.Row="0" ColumnDefinitions="2*, *, 196" RowDefinitions="Auto" Margin="0">
            <StackPanel Grid.Column="0" Margin="4 8 0 8">
                <z:Z2TextBox Name="FlagInputTextBox" PlaceholderText="Paste Flags Here"
                         BorderBrush="{Binding FlagInputBorderObservable^}" Label="Flag String" Text="{Binding FlagInput}" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <z:Z2TextBox Name="SeedInputTextBox" PlaceholderText="Paste Seed Here" Label="Seed" Text="{Binding Seed}">
                    <z:Z2TextBox.InnerRightContent>
                        <Button Name="RerollSeedButton" ToolTip.Tip="Generate a random number as your Seed" Classes="Flat" Width="{Binding $self.Bounds.Height}"
                                Command="{Binding RerollSeed}">
                            <PathIcon Name="RerollSeedIcon" Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconDiceMultiple}" />
                        </Button>
                    </z:Z2TextBox.InnerRightContent>
                </z:Z2TextBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button HorizontalAlignment="Right" Width="112" Content="Generate" IsEnabled="{Binding CanGenerateObservable^}"
                        Command="{Binding Generate}" />
                <Menu Padding="0" Margin="0" Width="80" ToolTip.Tip="Menu" AutomationProperties.Name="Application menu">
                    <MenuItem Height="48" Width="64" Cursor="Hand" AutomationProperties.Name="Application menu">
                        <MenuItem.Header>
                            <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconCog}" Width="32" Height="32" />
                        </MenuItem.Header>
                        <MenuItem Header="{Binding AppVersion}" IsEnabled="false">
                        </MenuItem>
                        <MenuItem Header="Check For Updates" IsVisible="{Binding IsDesktop}" Command="{Binding CheckForUpdates}" >
                            <MenuItem.Icon>
                                <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconUpdate}" Width="24" Height="24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Toggle Light/Dark Mode" Command="{Binding ToggleTheme}" >
                            <MenuItem.Icon>
                                <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconLightbulbNight}" Width="24" Height="24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Reload ROM" Command="{Binding LoadRom}" >
                            <MenuItem.Icon>
                                <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconReloadAlert}" Width="24" Height="24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Choose ROM Save Folder" IsVisible="{Binding IsDesktop}" Command="{Binding SaveFolder}" >
                            <MenuItem.Icon>
                                <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconContentSaveOutline}" Width="24" Height="24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Visit Discord"
                                  Command="{Binding VisitDiscord}"
                                  CommandParameter="{Binding $self}">
                        </MenuItem>
                        <MenuItem Header="Visit Wiki"
                                  Command="{Binding VisitWiki}"
                                  CommandParameter="{Binding $self}">
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Third-Party Notices"
                                  Command="{Binding VisitThirdPartyNotices}"
                                  CommandParameter="{Binding $self}">
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Name="Tabs" Margin="5" SelectedIndex="{Binding CurrentTabIndex}">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <views:MultiRowTabsPanel FirstRowCount="3">
                        <views:MultiRowTabsPanel.FirstRowContent>
                            <z:Z2TextBox Name="SearchInputTextBox" x:DataType="vm:RandomizerViewModel"
                                     PlaceholderText="Search settings" AutomationProperties.Name="Search options"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     GotFocus="OnSearchInputFocused"
                                     HorizontalAlignment="Stretch" Text="{Binding SearchViewModel.Query}">
                                <z:Z2TextBox.InnerLeftContent>
                                    <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconMagnify}" Width="20" Height="20" Margin="0,0,4,0" />
                                </z:Z2TextBox.InnerLeftContent>
                                <z:Z2TextBox.InnerRightContent>
                                    <Button ToolTip.Tip="Clear the search" AutomationProperties.Name="Clear the search"
                                            Classes="Flat" Padding="0" Width="32" Height="32"
                                            IsVisible="{Binding SearchViewModel.HasQuery}"
                                            Command="{Binding SearchViewModel.Clear}">
                                        <PathIcon Theme="{StaticResource ToolbarIconTheme}" Data="{StaticResource IconClose}" Width="20" Height="20" />
                                    </Button>
                                </z:Z2TextBox.InnerRightContent>
                            </z:Z2TextBox>
                        </views:MultiRowTabsPanel.FirstRowContent>
                    </views:MultiRowTabsPanel>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <Interaction.Behaviors>
                <views:TabContentPreservationBehavior />
            </Interaction.Behaviors>
            <TabItem Header="Presets">
                <tabs:PresetsView DataContext="{Binding PresetViewModel}"/>
            </TabItem>
            <TabItem Header="Player Options">
                <tabs:PlayerOptionsView DataContext="{Binding Main}" />
            </TabItem>
            <TabItem Header="Customize">
                <tabs:CustomizeView DataContext="{Binding Main}" />
            </TabItem>
            <TabItem Header="Start">
                <tabs:StartView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Biomes">
                <tabs:BiomesView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Overworld">
                <tabs:OverworldView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Palaces">
                <tabs:PalacesView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Levels">
                <tabs:LevelsView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Enemies">
                <tabs:EnemiesView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Items">
                <tabs:ItemsView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Drops">
                <tabs:DropsView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Hints" Background="{Binding HeaderBackgroundObservable^}">
                <tabs:HintsView DataContext="{Binding Main}"/>
            </TabItem>
            <TabItem Header="Patches">
                <tabs:PatchesView DataContext="{Binding Main}"/>
            </TabItem>
            <!-- Hidden search tab required for search to work -->
            <TabItem Header="Search" IsVisible="False">
                <tabs:SearchView DataContext="{Binding SearchViewModel}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
