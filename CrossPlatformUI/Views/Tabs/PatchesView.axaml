<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:CrossPlatformUI.Views"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             xmlns:z="clr-namespace:CrossPlatformUI.Controls"
             x:Class="CrossPlatformUI.Views.Tabs.PatchesView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <v:FlexColumnsPanel Margin="4 16">
            <TextBlock Text="Quality of Life" Classes="SectionHeader" />
            <z:Z2CheckBox Flag="RestartAtPalacesOnGameOver" />
            <z:Z2CheckBox Flag="Global5050JarDrop" />
            <z:Z2CheckBox Flag="ReduceDripperVariance" />
            <StackPanel Margin="0">
                <z:Z2CheckBox Flag="RevealWalkthroughWalls" />
                <z:Z2CheckBox Flag="RevealHiddenJars" />
            </StackPanel>
            <z:Z2CheckBox Flag="OptimizeSidecroll" />

            <StackPanel Margin="0">
                <TextBlock Text="Utility" Classes="SectionHeader" />
                <z:Z2ComboBox Flag="FireOption" />
                <z:Z2CheckBox Flag="FasterDashFairy" />
                <z:Z2ComboBox Flag="FluteWarpMode" />
            </StackPanel>

            <StackPanel Margin="0">
                <TextBlock Text="Enemy Hacks" Classes="SectionHeader" />
                <z:Z2CheckBox Flag="HardBosses" />
                <z:Z2CheckBox Flag="AggressiveTbird" />
            </StackPanel>

            <StackPanel Margin="0">
                <TextBlock Text="Fun" Classes="SectionHeader" />
                <z:Z2CheckBox Flag="JumpAlwaysOn" />
                <z:Z2CheckBox Flag="DashAlwaysOn" />
            </StackPanel>
            <z:Z2CheckBox Flag="PermanentBeamSword" />
            <z:Z2CheckBox Flag="RandomizeKnockback" />
            <z:Z2CheckBox Flag="MarioMode" />
        </v:FlexColumnsPanel>
    </ScrollViewer>
</UserControl>
