<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Popup scrolling reuses the app-owned scrollbar/gesture templates. -->
    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Z2ForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="{DynamicResource Z2MenuFontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="MenuItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ContentPresenter Name="MenuIcon" Content="{TemplateBinding Icon}" Width="24" Height="24"
                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                        <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <Path Name="SubmenuArrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Width="4" Height="8"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Name="MenuPopupSurface" Background="{DynamicResource Z2PaperBrush}"
                                    BorderBrush="{DynamicResource Z2DisabledForegroundBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <ScrollViewer Theme="{StaticResource Z2ComboBoxScrollViewer}" MaxHeight="500"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="RightEdgeAlignedTop" />
        </Style>
        <Style Selector="^:empty /template/ Path#SubmenuArrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:selected /template/ Border#MenuItemBorder, ^:pointerover /template/ Border#MenuItemBorder">
            <Setter Property="Background" Value="{DynamicResource Z2HoverBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.56" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="Z2MenuRootItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Padding" Value="8" />
        <Style Selector="^ /template/ ContentPresenter#MenuIcon, ^ /template/ Path#SubmenuArrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
            <Setter Property="IsLightDismissEnabled" Value="True" />
            <Setter Property="OverlayInputPassThroughElement" Value="{Binding $parent[Menu]}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Foreground" Value="{DynamicResource Z2ForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource Z2MenuRootItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource Z2DisabledForegroundBrush}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
