<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CrossPlatformUI"
             xmlns:converters="using:CrossPlatformUI.Converters"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:behaviors="clr-namespace:CrossPlatformUI.Behaviors"
             xmlns:z="using:CrossPlatformUI.Controls"
             x:Class="CrossPlatformUI.App">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Styles>
        <dialogHostAvalonia:DialogHostStyles />
        <StyleInclude Source="avares://CrossPlatformUI/Controls/Z2Dialogs.axaml" />

        <!-- Apply the shared presenter theme to view subclasses. -->
        <Style Selector=":is(UserControl)">
            <Setter Property="Theme" Value="{DynamicResource {x:Type UserControl}}" />
        </Style>
        <Style Selector=":is(TextBox)">
            <Setter Property="ContextFlyout" Value="{DynamicResource Z2TextContextFlyout}" />
            <Style Selector="^:touch-mode">
                <Setter Property="ContextFlyout" Value="{DynamicResource Z2TouchTextContextFlyout}" />
            </Style>
        </Style>


        <Style Selector="StackPanel">
            <Setter Property="Margin" Value="15, 8" />
        </Style>
        <Style Selector="StackPanel > :is(Control)">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style Selector="StackPanel > :is(ToggleButton)">
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style Selector=":is(ToggleButton) > TextBlock">
            <Setter Property="Margin" Value="10, 0" />
        </Style>
        <Style Selector="StackPanel > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Margin" Value="0 10" />
        </Style>

        <Style Selector="TextBlock.SectionHeader, TextBlock.SectionCaption">
            <Setter Property="FontFamily" Value="{DynamicResource Z2SectionFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource Z2SectionFontSize}"/>
            <Setter Property="FontStyle" Value="{DynamicResource Z2SectionFontStyle}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Z2SectionFontWeight}"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="TextBlock.SectionCaption">
            <Setter Property="FontFamily" Value="{DynamicResource Z2SectionCaptionFontFamily}"/>
            <Setter Property="FontStyle" Value="{DynamicResource Z2SectionCaptionFontStyle}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Z2SectionCaptionFontWeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource Z2SectionCaptionFontSize}"/>
            <Setter Property="Margin" Value="17,12,0,-2"/>
        </Style>

        <Style Selector="HyperlinkButton.WikiLink">
            <Setter Property="Foreground" Value="{DynamicResource Z2WikiLinkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="CheckBox, z|Z2CheckBox">
            <!-- Force the entire checkbox to be "clickable" and not just the pixels that the text covers -->
            <Setter Property="Background" Value="Transparent"/>
            <!-- By default the checkbox stretched to fill the container, which made way too much clickable, so
                 No more stretching! Stick to left aligned content by default for checkboxes. -->
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,4,0,4"/>
            <Setter Property="Margin" Value="14,4,4,4"/>
        </Style>
        <Style Selector="NumericUpDown.DifficultyOnly, z|Z2NumericUpDown.DifficultyOnly">
            <Setter Property="Background" Value="{DynamicResource Z2DifficultyHighlightBrush}" />
        </Style>

        <Style Selector="ComboBox, z|Z2ComboBox">
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16 4"/>
            <Setter Property="MaxDropDownHeight" Value="500"/>
        </Style>

        <!-- Mixed field rows share outline bounds; labels keep their own placement. -->
        <Style Selector="Grid.AlignedFields > z|Z2ComboBox, Grid.AlignedFields > z|Z2NumericUpDown">
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Grid.AlignedFields > z|Z2ComboBox /template/ StackPanel#FieldLayout">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Grid.AlignedFields > z|Z2ComboBox /template/ Grid#FieldContainer">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Grid.AlignedFields > z|Z2ComboBox /template/ Grid#FieldRoot">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Height" Value="52" />
        </Style>
        <Style Selector="Grid.AlignedFields > z|Z2NumericUpDown /template/ Border#FieldBorder">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Height" Value="52" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Add a default behavior to all of the comboboxes to let the scroll with the mouse wheel -->
        <Style Selector="ComboBox, z|Z2ComboBox, z|Z2SelectionBox">
            <Setter Property="(Interaction.Behaviors)">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <behaviors:ScrollSelectBehavior />
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown, z|Z2NumericUpDown">
            <Setter Property="(Interaction.Behaviors)">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <behaviors:ScrollSelectBehavior />
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>

    </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Application.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Button.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2CheckBox.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2ComboBox.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Content.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2FileChooser.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Hyperlink.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Menu.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2NumericUpDown.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Presets.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Tabs.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2TextBox.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2TextEditing.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2Scrolling.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Controls/Z2WindowDecorations.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/AppPalette.axaml" />
        <ResourceInclude Source="avares://CrossPlatformUI/Typography.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:SumOfValuesLessThanConverter x:Key="SumOfValuesLessThanConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
